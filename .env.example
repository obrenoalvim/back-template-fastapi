# --- Database ---
# Used directly when running without Docker (npm run dev-equivalent: `uv run uvicorn ...`).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5459/backtemplate
# Only used by docker-compose.yml to configure the `db` service and compose the app's
# DATABASE_URL for the `app` service (which talks to `db`, not `localhost`).
DB_HOST_PORT=5459
DB_NAME=backtemplate
DB_USER=postgres
DB_PASSWORD=postgres

# --- App ---
PORT=8082
ENVIRONMENT=dev
LOG_LEVEL=info

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-in-real-deployments
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Mail — leave MAIL_HOST unset in dev to use the console fallback ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
